{
  "name": "frontend-performance-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "24.19.0",
    "yarn": "1.22.22"
  },
  "scripts": {
    "dev": "next dev",
    "evidence:create": "node scripts/evidence.ts create",
    "evidence:validate": "node scripts/evidence.ts validate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "yarn lint && yarn format:check && yarn typecheck && yarn test:unit && yarn build && yarn test:e2e",
    "bundle:analyze": "BUNDLE_ANALYSIS_DIR=artifacts/bundle-loading playwright test e2e/bundle-loading.spec.ts --workers=1",
    "memory:journey": "playwright test --config scripts/memory/playwright.config.ts",
    "memory:validate": "MEMORY_VALIDATE_ONLY=1 playwright test --config scripts/memory/playwright.config.ts",
    "benchmark:diagnostic": "node scripts/benchmark/diagnostic.ts",
    "benchmark:preflight": "playwright test --config scripts/benchmark/playwright.config.ts",
    "benchmark": "node scripts/benchmark/cli.ts",
    "benchmark:compare": "node scripts/benchmark/cli.ts compare",
    "benchmark:budget": "node scripts/benchmark/budget-cli.ts",
    "investigation:validate": "node scripts/investigation.ts",
    "ci:validate": "node scripts/ci/validate.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-virtuoso": "^4.18.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "lighthouse": "13.4.1",
    "prettier": "^3.9.6",
    "puppeteer-core": "25.10.0",
    "typescript": "^5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
